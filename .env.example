# Local-first. Copy to web/.env and fill secrets as you collect them.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hair_heaven
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (optional for Phase 0; add in Phase 5)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (needed Phase 2; leave blank for now)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=hairven
# R2_PUBLIC_URL=

# Bank transfer details shown to customers (needed Phase 3)
# BANK_NAME=
# BANK_ACCOUNT_NUMBER=
# BANK_ACCOUNT_NAME=

# Card payments (Phase 3 — add when ready; manual transfer works without)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=

# Notifications (needed Phase 4/6)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# RESEND_API_KEY=
# EMAIL_FROM=
# TERMII_API_KEY=
# TERMII_SENDER_ID=
# GEMINI_API_KEY=

