# Local-first. Copy to web/.env and fill secrets as you collect them.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hair_heaven
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Extra login origins, comma-separated (e.g. your current public tunnel link)
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-link.trycloudflare.com
# Google OAuth (optional for Phase 0; add in Phase 5)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (needed Phase 2; leave blank for now)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=hairven
# R2_PUBLIC_URL=

# Bank transfer details shown to customers (needed Phase 3)
# BANK_NAME=
# BANK_ACCOUNT_NUMBER=
# BANK_ACCOUNT_NAME=

# Card payments (Phase 3 — add when ready; manual transfer works without)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=

# Notifications (reminders engine is built; sending activates per key)
# WhatsApp Cloud API — from developers.facebook.com
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Email receipts + signup alerts — from resend.com
# RESEND_API_KEY=
# EMAIL_FROM=Hairven <hello@yourdomain.com>
# Ese's own inbox for new-member alerts (add your email address)
# ADMIN_EMAIL=
# SMS (urgent reminders) — from termii.com
# TERMII_API_KEY=
# TERMII_SENDER_ID=Hairven
# Scheduler password for POST /api/cron/reminders (auto-generated locally)
# CRON_SECRET=
# GEMINI_API_KEY=

